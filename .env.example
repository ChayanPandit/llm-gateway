GATEWAY_API_KEY=sk-local-dev-change-me
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ADDR=:8080

# Reliability (all optional; defaults shown)
REQUEST_TIMEOUT=120s
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=100ms
RETRY_MAX_DELAY=5s
BREAKER_THRESHOLD=5
BREAKER_RESET=30s

# Failover: if <provider>'s call fails (after retries / breaker open),
# the gateway tries the fallback model below. Empty = no fallback.
FAILOVER_OPENAI=
FAILOVER_ANTHROPIC=

# Cache (exact-match, Redis-backed). Set CACHE_ENABLED=true to opt in.
# Streams are not cached. Clients can disable per-request with
# `Cache-Control: no-store`.
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379
CACHE_TTL=24h
CACHE_NAMESPACE=llmcache:

# Semantic cache (Redis Stack RediSearch + OpenAI embeddings).
# Builds on the exact cache: SEMANTIC_CACHE_ENABLED requires
# CACHE_ENABLED=true, Redis Stack running, and OPENAI_API_KEY set
# (regardless of which chat provider you use).
SEMANTIC_CACHE_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small
SIMILARITY_THRESHOLD=0.95
