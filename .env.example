GATEWAY_API_KEY=sk-local-dev-change-me
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ADDR=:8080

# Reliability (all optional; defaults shown)
REQUEST_TIMEOUT=120s
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=100ms
RETRY_MAX_DELAY=5s
BREAKER_THRESHOLD=5
BREAKER_RESET=30s

# Failover: if <provider>'s call fails (after retries / breaker open),
# the gateway tries the fallback model below. Empty = no fallback.
FAILOVER_OPENAI=
FAILOVER_ANTHROPIC=
